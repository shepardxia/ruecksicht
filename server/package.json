{
  "name": "uebersicht-server",
  "version": "0.0.0",
  "description": "Client bundle, transform kernel and widget diagnostics for Rücksicht",
  "scripts": {
    "test": "npm run-script test-local && npm run-script test-browser",
    "test-local": "tape -r coffee-script/register spec/backend/**/* | tap-spec",
    "test-browser": "browserify -t coffeeify  spec/frontend/*.*  | tape-run | tap-spec",
    "build-client": "browserify -i ws -t coffeeify -t babelify -r ./src/uebersicht.js:uebersicht client.coffee | uglifyjs -c > release/public/client.js",
    "build-kernel": "node kernel/build.js"
  },
  "author": "Felix Hageloh",
  "license": "GPL v3 <http://www.gnu.org/licenses/>",
  "private": true,
  "devDependencies": {
    "coffee-script": "^1.12.7",
    "esbuild": "^0.28.2",
    "sinon": "^4.0.1",
    "tap-spec": "^5.0.0",
    "tape": "^4.13.3",
    "tape-run": "^9.0.0",
    "uglify-js": "^3.10.4"
  },
  "dependencies": {
    "@babel/core": "^7.11.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.11.0",
    "@babel/preset-env": "^7.11.5",
    "@babel/preset-react": "^7.10.4",
    "@emotion/styled": "^10.0.27",
    "babelify": "^10.0.0",
    "browserify": "^16.5.2",
    "coffeeify": "^2.1.0",
    "emotion": "^10.0.27",
    "escodegen": "^1.14.3",
    "esprima": "^2.7.3",
    "jquery": "^3.5.1",
    "ms": "^2.0.0",
    "nib": "~1.1.2",
    "raf": "^3.4.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "redux": "^3.7.2",
    "stylus": "^0.54.8",
    "superagent": "^3.8.3",
    "tosource": "~1.0.0",
    "ws": "^6.0.0"
  }
}
